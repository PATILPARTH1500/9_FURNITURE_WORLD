# Atelier Archetyp Environment Configuration

# Supabase Project Credentials
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-Only Service Role Key (NEVER expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Video CDN / Object Storage URL (leave empty for local fallback)
# Example: https://your-cdn.com or https://your-project.supabase.co/storage/v1/object/public/videos
NEXT_PUBLIC_VIDEO_CDN_URL=

