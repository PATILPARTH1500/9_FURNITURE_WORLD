# Furniture Village Environment Configuration (Vite + React)

# Supabase Project Credentials (Client-Safe Anon Key)
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Application Base URL
VITE_SITE_URL=http://localhost:3000

# Optional Video CDN / Object Storage URL (leave empty for local fallback)
# Example: https://your-cdn.com or https://your-project.supabase.co/storage/v1/object/public/videos
VITE_VIDEO_CDN_URL=

# NOTE: SUPABASE_SERVICE_ROLE_KEY is strictly for backend / edge functions only.
# NEVER prefix it with VITE_ or expose it to client-side bundles.
